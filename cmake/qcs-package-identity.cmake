include_guard(GLOBAL)

# Candidate metadata is inside each user package, never an extra CI artifact.
set(QCOPILOTS_SEARCH_CANDIDATE_COMMIT "" CACHE STRING "Complete immutable candidate Git commit, or empty for a local build")
set(QCOPILOTS_SEARCH_CANDIDATE_ATTEMPT "1" CACHE STRING "Original CI run attempt that produced this package")
if(NOT QCOPILOTS_SEARCH_CANDIDATE_ATTEMPT MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "QCOPILOTS_SEARCH_CANDIDATE_ATTEMPT must be a positive integer")
endif()
if(NOT QCOPILOTS_SEARCH_VARIANT MATCHES "^[a-z0-9][a-z0-9.-]*$")
  message(FATAL_ERROR "Package identity requires a valid QCOPILOTS_SEARCH_VARIANT")
endif()
file(READ "${PROJECT_SOURCE_DIR}/config/build-variants.json" _qcs_variants_json)
string(JSON _qcs_variant_count LENGTH "${_qcs_variants_json}" variants)
math(EXPR _qcs_variant_last "${_qcs_variant_count} - 1")
set(_qcs_package_backend "")
foreach(_qcs_variant_index RANGE ${_qcs_variant_last})
  string(JSON _qcs_variant_id GET "${_qcs_variants_json}" variants ${_qcs_variant_index} id)
  if(_qcs_variant_id STREQUAL QCOPILOTS_SEARCH_VARIANT)
    string(JSON _qcs_package_backend GET "${_qcs_variants_json}" variants ${_qcs_variant_index} backend)
    string(JSON _qcs_package_variant GET "${_qcs_variants_json}" variants ${_qcs_variant_index} packageVariant)
    string(JSON _qcs_package_toolkit GET "${_qcs_variants_json}" variants ${_qcs_variant_index} toolkitVersion)
  endif()
endforeach()
if(_qcs_package_backend STREQUAL "")
  message(FATAL_ERROR "Unknown package variant: ${QCOPILOTS_SEARCH_VARIANT}")
endif()
set(_qcs_package_commit "null")
set(_qcs_package_modified "null")
set(_qcs_package_revision "local-source")
find_package(Git QUIET)
if(Git_FOUND AND EXISTS "${PROJECT_SOURCE_DIR}/.git")
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --verify HEAD
    WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" RESULT_VARIABLE _qcs_git_status
    OUTPUT_VARIABLE _qcs_head OUTPUT_STRIP_TRAILING_WHITESPACE)
  execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain
    WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" RESULT_VARIABLE _qcs_status_status
    OUTPUT_VARIABLE _qcs_dirty OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT _qcs_git_status EQUAL 0 OR NOT _qcs_status_status EQUAL 0)
    message(FATAL_ERROR "Cannot determine package source identity")
  endif()
  set(_qcs_package_commit "\"${_qcs_head}\"")
  string(SUBSTRING "${_qcs_head}" 0 12 _qcs_package_revision)
  set(_qcs_package_modified false)
  if(NOT _qcs_dirty STREQUAL "")
    set(_qcs_package_modified true)
    if(QCOPILOTS_SEARCH_CANDIDATE_COMMIT STREQUAL "")
      string(APPEND _qcs_package_revision "-dirty")
    endif()
  endif()
endif()
if(NOT QCOPILOTS_SEARCH_CANDIDATE_COMMIT STREQUAL "")
  string(LENGTH "${QCOPILOTS_SEARCH_CANDIDATE_COMMIT}" _qcs_commit_length)
  if(NOT _qcs_commit_length EQUAL 40 OR NOT QCOPILOTS_SEARCH_CANDIDATE_COMMIT MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "QCOPILOTS_SEARCH_CANDIDATE_COMMIT requires the complete lowercase Git SHA")
  endif()
  if(NOT _qcs_head STREQUAL QCOPILOTS_SEARCH_CANDIDATE_COMMIT OR NOT _qcs_package_modified STREQUAL "false")
    message(FATAL_ERROR "Immutable candidate packaging requires the matching clean Git checkout")
  endif()
endif()
file(SHA256 "${PROJECT_SOURCE_DIR}/dependencies.lock.json" _qcs_dependency_sha)
file(SHA256 "${PROJECT_SOURCE_DIR}/config/build-variants.json" _qcs_variants_sha)
file(SHA256 "${PROJECT_SOURCE_DIR}/config/gpu-sdk.lock.json" _qcs_gpu_sdk_sha)
file(SHA256 "${PROJECT_SOURCE_DIR}/config/gpu-license-sources.lock.json" _qcs_gpu_license_sha)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/qcs-build-identity-$<CONFIG>.json" CONTENT
"{\n  \"schemaVersion\": 1,\n  \"version\": \"${PROJECT_VERSION}\",\n  \"variant\": \"${QCOPILOTS_SEARCH_VARIANT}\",\n  \"packageVariant\": \"${_qcs_package_variant}\",\n  \"toolkitVersion\": \"${_qcs_package_toolkit}\",\n  \"backend\": \"${_qcs_package_backend}\",\n  \"configuration\": \"$<CONFIG>\",\n  \"candidateCommit\": ${_qcs_package_commit},\n  \"workingTreeModified\": ${_qcs_package_modified},\n  \"attempt\": ${QCOPILOTS_SEARCH_CANDIDATE_ATTEMPT},\n  \"dependencyLockSha256\": \"${_qcs_dependency_sha}\",\n  \"variantsSha256\": \"${_qcs_variants_sha}\",\n  \"gpuSdkLockSha256\": \"${_qcs_gpu_sdk_sha}\",\n  \"gpuLicenseLockSha256\": \"${_qcs_gpu_license_sha}\"\n}\n")
