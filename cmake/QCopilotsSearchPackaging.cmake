include_guard(GLOBAL)
if(MSVC)
  # Qt's deploy tool supplies a redist installer. Portable ZIP packages and
  # the per-user installer need these redistributable DLLs beside the app.
  set(CMAKE_INSTALL_OPENMP_LIBRARIES TRUE)
  set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION "${CMAKE_INSTALL_BINDIR}")
  set(CMAKE_INSTALL_SYSTEM_RUNTIME_COMPONENT qcopilots-search-runtime)
  include(InstallRequiredSystemLibraries)
  foreach(_required_runtime msvcp140.dll vcruntime140.dll vcomp140.dll)
    set(_found_runtime FALSE)
    foreach(_runtime_file IN LISTS CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS)
      cmake_path(GET _runtime_file FILENAME _runtime_name)
      if(_runtime_name STREQUAL _required_runtime)
        set(_found_runtime TRUE)
      endif()
    endforeach()
    if(NOT _found_runtime)
      message(FATAL_ERROR "Visual C++ redistributable runtime is missing: ${_required_runtime}")
    endif()
  endforeach()
endif()
set(_qcopilots_programs)
foreach(_program qcopilots-search qcopilots-search-service qcopilots-search-worker qcopilots-search-cli)
  if(TARGET ${_program})
    list(APPEND _qcopilots_programs ${_program})
    if(APPLE AND NOT _program STREQUAL "qcopilots-search")
      install(TARGETS ${_program} RUNTIME DESTINATION "qcopilots-search.app/Contents/MacOS")
    else()
      install(TARGETS ${_program} RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} BUNDLE DESTINATION .)
    endif()
  endif()
endforeach()
if(TARGET qcopilots-search AND QCOPILOTS_SEARCH_DEPLOY_QT)
  if(NOT TARGET Qt6::QOffscreenIntegrationPlugin)
    message(FATAL_ERROR "The Qt SDK must provide the offscreen platform plugin used by the worker")
  endif()
  if(APPLE)
    set(_qcopilots_offscreen_destination "qcopilots-search.app/Contents/PlugIns/platforms")
  else()
    set(_qcopilots_offscreen_destination "plugins/platforms")
  endif()
  # Workers use a QGuiApplication for image/PDF extraction without requiring a
  # desktop session. Qt's deployment tool otherwise selects only qwindows/qxcb.
  install(FILES "$<TARGET_FILE:Qt6::QOffscreenIntegrationPlugin>"
    DESTINATION "${_qcopilots_offscreen_destination}")
  set(_qcopilots_runtime_options)
  if(MSVC)
    set(_qcopilots_runtime_options NO_COMPILER_RUNTIME)
  endif()
  set(_qcopilots_extra_executables)
  foreach(_helper qcopilots-search-service qcopilots-search-worker qcopilots-search-cli)
    if(TARGET ${_helper})
      if(APPLE)
        string(APPEND _qcopilots_extra_executables " \"\${QT_DEPLOY_PREFIX}/qcopilots-search.app/Contents/MacOS/$<TARGET_FILE_NAME:${_helper}>\"")
      else()
        string(APPEND _qcopilots_extra_executables " \"$<TARGET_FILE:${_helper}>\"")
      endif()
    endif()
  endforeach()
  if(APPLE)
    set(_qcopilots_deploy_executable "qcopilots-search.app")
  else()
    set(_qcopilots_deploy_executable "$<TARGET_FILE:qcopilots-search>")
  endif()
  qt_generate_deploy_script(TARGET qcopilots-search OUTPUT_SCRIPT _qcopilots_deploy
    CONTENT "qt_deploy_runtime_dependencies(\n EXECUTABLE \"${_qcopilots_deploy_executable}\"\n ADDITIONAL_EXECUTABLES ${_qcopilots_extra_executables}\n ${_qcopilots_runtime_options}\n GENERATE_QT_CONF\n)")
  install(SCRIPT "${_qcopilots_deploy}")
endif()
install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" "${PROJECT_SOURCE_DIR}/dependencies.lock.json"
  DESTINATION "${CMAKE_INSTALL_DATADIR}/qcopilots-search")
if(EXISTS "${PROJECT_SOURCE_DIR}/THIRD_PARTY_NOTICES.md")
  install(FILES "${PROJECT_SOURCE_DIR}/THIRD_PARTY_NOTICES.md"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/qcopilots-search")
endif()
install(FILES "${PROJECT_SOURCE_DIR}/tools/qt-packages.lock.json"
  DESTINATION "${CMAKE_INSTALL_DATADIR}/qcopilots-search")
if(EXISTS "${PROJECT_SOURCE_DIR}/third_party")
  install(DIRECTORY "${PROJECT_SOURCE_DIR}/third_party/"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/qcopilots-search/source-materials")
endif()
install(DIRECTORY "${PROJECT_SOURCE_DIR}/docs/" DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/qcopilots-search")
set(CPACK_PACKAGE_NAME "qcopilots-search")
set(CPACK_PACKAGE_VENDOR "QCopilots")
set(CPACK_PACKAGE_CONTACT "https://github.com/xiaobing318/QCopilots-search/issues")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Local multilingual multimodal desktop search")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "QCopilots Search")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_BINARY_DIR}/../packages")
set(CPACK_PACKAGE_FILE_NAME "qcopilots-search-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_STRIP_FILES TRUE)
set(CPACK_PROJECT_CONFIG_FILE "${PROJECT_SOURCE_DIR}/cmake/QCopilotsSearchCPackConfig.cmake")
if(WIN32)
  set(CPACK_GENERATOR ZIP)
  set(CPACK_NSIS_DISPLAY_NAME "QCopilots Search")
  set(CPACK_NSIS_INSTALLED_ICON_NAME "bin\\qcopilots-search.exe")
  set(CPACK_NSIS_EXECUTABLES_DIRECTORY bin)
  set(CPACK_PACKAGE_EXECUTABLES "qcopilots-search" "QCopilots Search")
  set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL OFF)
  set(CPACK_NSIS_INSTALL_ROOT "$LOCALAPPDATA/Programs")
  set(CPACK_NSIS_EXECUTION_LEVEL user)
elseif(APPLE)
  set(CPACK_GENERATOR DragNDrop)
else()
  set(CPACK_GENERATOR "TGZ;DEB")
  set(CPACK_DEBIAN_PACKAGE_MAINTAINER "QCopilots contributors")
  set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
  set(CPACK_DEBIAN_PACKAGE_SECTION utils)
endif()
include(CPack)
