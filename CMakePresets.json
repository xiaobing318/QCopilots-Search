{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 28, "patch": 0},
  "configurePresets": [
    {
      "name": "qcs-release",
      "displayName": "QCopilots Search external Release build",
      "generator": "Ninja",
      "binaryDir": "$env{QCOPILOTS_SEARCH_BUILD_ROOT}/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{QCOPILOTS_SEARCH_QT_PREFIX}",
        "CMAKE_INSTALL_PREFIX": "$env{QCOPILOTS_SEARCH_BUILD_ROOT}/stage",
        "QCOPILOTS_SEARCH_DEPENDENCY_ROOT": "$env{QCOPILOTS_SEARCH_BUILD_ROOT}/deps",
        "QCOPILOTS_SEARCH_TEST_ROOT": "$env{QCOPILOTS_SEARCH_BUILD_ROOT}/runs",
        "QCOPILOTS_SEARCH_BUILD_TESTS": "ON"
      },
      "condition": {"type": "notEquals", "lhs": "$env{QCOPILOTS_SEARCH_BUILD_ROOT}", "rhs": ""}
    },
    {
      "name": "qcs-debug",
      "inherits": "qcs-release",
      "binaryDir": "$env{QCOPILOTS_SEARCH_BUILD_ROOT}/debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    }
  ],
  "buildPresets": [
    {"name": "qcs-release", "configurePreset": "qcs-release"},
    {"name": "qcs-debug", "configurePreset": "qcs-debug"}
  ],
  "testPresets": [
    {"name": "qcs-release", "displayName": "Release fast tests", "description": "Exclude slow tests. No model download, application installation or packaging.", "configurePreset": "qcs-release", "filter": {"exclude": {"label": "^slow$"}}, "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "qcs-debug", "displayName": "Debug fast tests", "description": "Exclude slow tests. No model download, application installation or packaging.", "configurePreset": "qcs-debug", "filter": {"exclude": {"label": "^slow$"}}, "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "qcs-release-full", "displayName": "Release full tests", "description": "All registered tests, including slow tests. Prepare models first, or use qcs-dev check --test-profile full for the complete flow.", "configurePreset": "qcs-release", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "qcs-debug-full", "displayName": "Debug full tests", "description": "All registered tests, including slow tests. Prepare models first, or use qcs-dev check --test-profile full for the complete flow.", "configurePreset": "qcs-debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
  ],
  "workflowPresets": [
    {"name": "qcs-release", "steps": [{"type": "configure", "name": "qcs-release"}, {"type": "build", "name": "qcs-release"}, {"type": "test", "name": "qcs-release"}]},
    {"name": "qcs-release-full", "steps": [{"type": "configure", "name": "qcs-release"}, {"type": "build", "name": "qcs-release"}, {"type": "test", "name": "qcs-release-full"}]},
    {"name": "qcs-debug", "steps": [{"type": "configure", "name": "qcs-debug"}, {"type": "build", "name": "qcs-debug"}, {"type": "test", "name": "qcs-debug"}]},
    {"name": "qcs-debug-full", "steps": [{"type": "configure", "name": "qcs-debug"}, {"type": "build", "name": "qcs-debug"}, {"type": "test", "name": "qcs-debug-full"}]}
  ]
}
